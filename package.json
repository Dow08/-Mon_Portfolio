{
  "name": "portfolio-dorian-poncelet",
  "private": true,
  "description": "Outils de test du portfolio (aucune dépendance côté site : le site est en HTML/CSS/JS pur).",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check:csp": "node scripts/check_csp.mjs",
    "lint": "eslint js scripts tests eslint.config.js",
    "lint:html": "html-validate index.html 404.html accessibilite.html",
    "check": "npm run lint && npm run lint:html && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "html-validate": "11.16.2",
    "puppeteer-core": "25.13.0"
  }
}
